# Everything the container reads. Copy to .env and edit; .env is git-ignored.
# Only DATABASE_URL and ALLOWED_EMAILS are needed for a working instance.

# postgres://user:password@host:5432/database, or a SQLite file path.
# A relative path is created if missing. In the bundled Compose profile this is
# set to the `db` service automatically.
DATABASE_URL=file:./data/cuota.db

# Port the server listens on inside the container.
PORT=3000
# Host port for docker compose (maps to PORT inside).
HOST_PORT=3000

# Emails allowed to sign up, comma separated, case-insensitive.
# The first-run setup wizard will remove the need to set this before the first
# account exists.
ALLOWED_EMAILS=

# Passkeys. Set both or neither: with neither, the passkey endpoints answer 503
# and password sign-in still works. PASSKEY_RP_ID is the origin's host exactly.
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
PASSKEY_RP_NAME=Cuota

# Optional invoice photo reading. Leave unset to turn the /scan page off.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Shown on /about.
APP_VERSION=0.0.0-dev
ABOUT_BUILT_BY=
ABOUT_EMAIL=
ABOUT_GITHUB=