{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "adapters/**/*.ts", "server/**/*.ts"],
	"exclude": ["node_modules", "dist", "build", "test"]
}