{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "./build",
		"rootDir": ".",
		"types": ["node"],
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false
	},
	"include": ["src/**/*.ts", "adapters/**/*.ts", "server/**/*.ts"],
	"exclude": ["node_modules", "dist", "build", "test"]
}