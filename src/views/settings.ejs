<%- include("_head") %>
<main class="app form-page">

  <header class="topbar">
    <div class="wordmark">your <em>settings</em></div>
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn secondary" type="submit">Sign out</button>
    </form>
  </header>

  <% if (typeof error !== "undefined" && error) { %>
    <p class="notice error" role="alert"><%= error %></p>
  <% } %>
  <% if (typeof notice !== "undefined" && notice) { %>
    <p class="notice ok" role="status"><%= notice %></p>
  <% } %>

  <section class="card settings-card" aria-labelledby="passkeys-title">
    <h2 id="passkeys-title">Passkeys</h2>
    <p class="hint">Sign in with Touch&nbsp;ID or your device passcode. Your password always works too.</p>

    <% if (passkeys.length === 0) { %>
      <p class="muted">No passkeys yet.</p>
    <% } else { %>
      <ul class="passkeys">
        <% passkeys.forEach(function (passkey) { %>
          <li>
            <div class="meta">
              <div class="name"><%= passkey.name %></div>
              <div class="when">Added <%= passkey.created %> · <%= passkey.lastUsed ? "Last used " + passkey.lastUsed : "Never used" %></div>
            </div>
            <form action="/settings/passkeys/<%= passkey.id %>/delete" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn danger" type="submit" aria-label="Delete <%= passkey.name %>">Delete</button>
            </form>
          </li>
        <% }); %>
      </ul>
    <% } %>

    <button class="btn secondary" type="button" id="passkeyRegisterButton" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5Zm-3 8V7a3 3 0 1 1 6 0v3H9Z" fill="currentColor"/></svg>
      Register a new passkey
    </button>
    <p class="hint" id="passkeyRegisterStatus" role="status" aria-live="polite" data-passkey-status>Use this device to add another passkey.</p>
  </section>

  <section class="card settings-card" aria-labelledby="appearance-title" data-theme-control>
    <fieldset class="appearance">
      <legend id="appearance-title">Appearance</legend>
      <p class="hint">Follow this device, or choose a theme for Cuota on this browser.</p>
      <div class="appearance-options">
        <label>
          <input type="radio" name="color-scheme" value="system" checked>
          <span>System</span>
        </label>
        <label>
          <input type="radio" name="color-scheme" value="light">
          <span>Light</span>
        </label>
        <label>
          <input type="radio" name="color-scheme" value="dark">
          <span>Dark</span>
        </label>
      </div>
      <p class="hint" data-system-theme>System (currently light)</p>
    </fieldset>
  </section>

  <section class="card settings-card" aria-labelledby="password-title">
    <h2 id="password-title">Change password</h2>
    <form action="/settings/password" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="current">Current password</label>
        <input id="current" name="current" type="password" autocomplete="current-password" required>
      </div>
      <div class="field">
        <label for="next">New password</label>
        <input id="next" name="next" type="password" autocomplete="new-password" minlength="12" required>
      </div>
      <button class="btn" type="submit">Change password</button>
    </form>
  </section>

  <section class="card settings-card" aria-labelledby="about-link-title">
    <h2 id="about-link-title">About this app</h2>
    <p class="hint">Who built Cuota, the running version, and how to get in touch.</p>
    <a href="/about">About Cuota</a>
  </section>

</main>

<%- include("_nav", { active: "settings" }) %>
<%- include("_foot", { passkey: true, theme: true }) %>
