<%- include("_head") %>
<main class="app login">
  <div class="brand">
    <div class="wordmark">cuo<em>ta</em></div>
    <h1><%= title %></h1>
    <% if (typeof error !== "undefined" && error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
    <p class="hint"><a href="<%= typeof authenticated !== "undefined" && authenticated ? "/" : "/login" %>"><%= typeof authenticated !== "undefined" && authenticated ? "Back to home" : "Return to sign in" %></a></p>
  </div>
</main>
<%- include("_foot") %>
