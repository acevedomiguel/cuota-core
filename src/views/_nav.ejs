<%
const sidebarLinks = [
	{ href: "/add", key: "add", label: "＋ Add" },
	{ href: "/scan", key: "scan", label: "Scan" },
	{ href: "/analytics", key: "analytics", label: "Analytics" },
	{ href: "/incomes", key: "incomes", label: "Salary" },
	{ href: "/opening-balance", key: "opening", label: "Opening" },
	{ href: "/settings", key: "settings", label: "Settings" },
	{ href: "/about", key: "about", label: "About" },
];
const pillLinks = [
	{ href: "/", key: "home", label: "Home" },
	{ href: "/analytics", key: "analytics", label: "Analytics" },
	{ href: "/add", key: "add", label: "+", fab: true },
	{ href: "/scan", key: "scan", label: "Scan" },
	{ href: "/incomes", key: "incomes", label: "Salary" },
	{ href: "/opening-balance", key: "opening", label: "Opening" },
	{ href: "/settings", key: "settings", label: "Settings" },
];
%>
<nav class="sidebar" aria-label="Main">
  <a class="brand wordmark" href="/">cuo<em>ta</em></a>
  <ul>
    <% sidebarLinks.forEach(function (link) { %>
      <li><a href="<%= link.href %>"<%- active === link.key ? ' aria-current="page" class="active"' : "" %>><%= link.label %></a></li>
    <% }); %>
  </ul>
  <button
    type="button"
    class="theme-toggle"
    data-theme-toggle
    aria-label="Theme: Auto (system). Switch to Light."
    title="Theme: Auto (system). Switch to Light."
  >
    <svg data-theme-icon="system" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
      <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor"/>
    </svg>
    <svg data-theme-icon="light" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false" hidden>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
      <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <svg data-theme-icon="dark" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false" hidden>
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    </svg>
  </button>
  <span class="visually-hidden" data-theme-status role="status" aria-live="polite" aria-atomic="true"></span>
</nav>
<nav class="bottombar" aria-label="Main">
  <div class="pill">
    <% pillLinks.forEach(function (link) { %>
      <a href="<%= link.href %>"<%- link.fab ? ' class="fab" aria-label="Add expense"' : "" %><%- active === link.key ? (link.fab ? ' aria-current="page"' : ' class="active" aria-current="page"') : "" %>><%= link.label %></a>
    <% }); %>
  </div>
</nav>
